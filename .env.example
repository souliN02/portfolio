# Copy to .env.local for local development, and add the same variables in Vercel.
# Every variable is optional: without them the site still works, and the Outlook Express
# contact form hands messages to the visitor's own mail app instead.

# Outlook Express contact form (app/api/contact), sent with Resend
RESEND_API_KEY=
# Where messages go. Defaults to the address in data/profile.ts
CONTACT_TO_EMAIL=
# A sender on a domain you have verified in Resend, e.g. "Portfolio <hello@bekirsaliv.dk>".
# Without it Resend's test sender is used, which only delivers to your own Resend account address.
CONTACT_FROM_EMAIL=
